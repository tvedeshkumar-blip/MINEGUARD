# MINEGUARD Backend Service Environment Configuration Template

# Server Networking
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Python AI Vision Microservice Networking
VISION_HOST=127.0.0.1
VISION_PORT=8001

# Firebase Cloud Persistence & Admin SDK
FIREBASE_DATABASE_URL=https://mine-safety-rover-default-rtdb.firebaseio.com/
FIREBASE_PROJECT_ID=mine-safety-rover
FIREBASE_CLIENT_EMAIL=your-service-account@mine-safety-rover.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Persistence Provider Choice (sqlite | firebase)
DATA_PROVIDER=sqlite

