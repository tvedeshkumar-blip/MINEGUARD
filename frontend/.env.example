# MINEGUARD Frontend Environment Configuration Template

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Telemetry WebSocket Stream URL
VITE_WS_BASE_URL=ws://localhost:5000/ws

# Firebase Realtime Database Configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=mine-safety-rover.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://mine-safety-rover-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=mine-safety-rover
VITE_FIREBASE_STORAGE_BUCKET=mine-safety-rover.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID
