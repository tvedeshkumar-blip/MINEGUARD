# MINEGUARD AI Vision Service Configuration

# Camera Ingestion Source: 'esp32' | 'simulator' | 'file'
CAMERA_SOURCE=simulator

# ESP32-CAM Configuration (Required when CAMERA_SOURCE=esp32)
ESP32_CAM_URL=http://192.168.1.100
ESP32_STREAM_ENDPOINT=/stream
ESP32_CONNECT_TIMEOUT=4.0
ESP32_READ_TIMEOUT=6.0

# Offline File Mode (Required when CAMERA_SOURCE=file)
TEST_VIDEO_PATH=./test-data/rover_recon.mp4

# Vision Service Networking
VISION_HOST=0.0.0.0
VISION_PORT=8001

# AI Pretrained Model Configuration
AI_DETECTION_ENABLED=true
MODEL_TYPE=pretrained
YOLO_MODEL=yolo11n.pt
CUSTOM_MODEL_PATH=
YOLO_CONFIDENCE=0.40
YOLO_IOU=0.45
AI_DEVICE=auto

# AI Pseudo-Thermal Vision Engine
THERMAL_ENABLED=true
THERMAL_COLORMAP=INFERNO
THERMAL_HOTSPOT_THRESHOLD=0.80
HOTSPOT_MIN_AREA=120

# Performance & Rate Limits
TARGET_FPS=15
AI_FRAME_SKIP=2
